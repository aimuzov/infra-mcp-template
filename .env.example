# Удалённый коннектор, `serve --http`. Для stdio хватает API_TOKEN в конфиге MCP-клиента.
PUBLIC_URL=https://__DOMAIN__
# Ключ токенов доступа, не короче 32 символов: openssl rand -base64 48
AUTH_SECRET=
PORT=8080
# Колбэки OAuth сверх колбэков Claude и loopback, через запятую.
ALLOWED_REDIRECT_URIS=
